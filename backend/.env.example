PORT=5000
NODE_ENV=development

# Use local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/cpf?retryWrites=true&w=majority

# Required for JWT auth
JWT_SECRET=replace_with_a_strong_secret

# Comma-separated frontend origins for CORS (example supports local + deployed frontend)
FRONTEND_URL=http://localhost:5173,https://your-frontend-domain.com

# Optional: email reminders via Nodemailer (Gmail app password suggested)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Contest API sources
CODEFORCES_API_URL=https://codeforces.com/api/contest.list?gym=false
ATCODER_API_URL=https://kenkoooo.com/atcoder/resources/contests.json
LEETCODE_API_URL=your_leetcode_contest_endpoint
CODECHEF_API_URL=your_codechef_contest_endpoint
